// Allow one clan group (routing to fd comes from the channel-wide binding in fd.base.json5).
// __CLAN_CHAT_ID__ is filled in by scripts/apply-config.sh.
{
  channels: {
    telegram: {
      groups: {
        "__CLAN_CHAT_ID__": {
          enabled: true,
          groupPolicy: "open",
          requireMention: true,
          tools: { allow: ["tekken_frame_data", "tekken_pick_move"] },
        },
      },
    },
  },
}
