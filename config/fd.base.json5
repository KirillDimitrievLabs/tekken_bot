// tekken-fd plugin + isolated "fd" agent. Applied by scripts/apply-config.sh.
{
  channels: {
    telegram: {
      // Bot replies are threaded to the message they answer (Telegram reply/quote).
      replyToMode: "first",
      // Anyone may DM the bot; non-owner DMs route to the locked-down fd agent (bindings below),
      // where the tekken-fd plugin only answers !fd, /start and /help.
      dmPolicy: "open",
      allowFrom: ["*"],
      // In groups not configured under channels.telegram.groups only the owner is heard.
      groupAllowFrom: ["100000001"],
      // OpenClaw's own command menu is off; tekken-fd sets per-scope menus (public: /start /help).
      commands: { native: false, nativeSkills: false },
    },
  },
  // OpenClaw chat commands (/new, /status, /model, …) only for the owner.
  commands: { allowFrom: { telegram: ["100000001", "telegram:100000001"] } },
  // Every DM user gets their own session (no shared history between clan members).
  session: { dmScope: "per-channel-peer" },
  // Owner's DM → private main agent; every other Telegram chat (DMs, groups) → fd.
  bindings: [
    { agentId: "main", match: { channel: "telegram", peer: { kind: "direct", id: "100000001" } } },
    { agentId: "fd", match: { channel: "telegram" } },
  ],
  plugins: {
    load: { paths: ["/opt/clan-bots/plugins/tekken-fd"] },
    entries: { "tekken-fd": { enabled: true, config: { repoDir: "/opt/clan-bots" } } },
  },
  agents: {
    // Global: don't seed onboarding files (BOOTSTRAP.md, SOUL.md, …) into new workspaces.
    defaults: { skipBootstrap: true },
    entries: {
      fd: {
        name: "Frame Data",
        identity: { name: "Frame Data" },
        workspace: "/home/node/.openclaw/workspace-fd",
        agentDir: "/home/node/.openclaw/agents/fd/agent",
        model: "openai/gpt-6-luna",
        models: { "openai/gpt-6-luna": { agentRuntime: { id: "openclaw" } } },
        skills: [],
        thinkingDefault: "minimal", // fastest in a 4-way benchmark (6.2s avg per lookup), 2026-10-14
        // Code Mode would hide these tools behind a JS `exec` (Node vm, not a sandbox) — keep it off
        // for an agent that untrusted group members can prompt.
        tools: { allow: ["tekken_frame_data", "tekken_pick_move"], codeMode: { enabled: false } },
        groupChat: { mentionPatterns: ["^\\s*!(fd|punish|unsafe|list|help)\\b"], historyLimit: 10 },
      },
    },
  },
}
