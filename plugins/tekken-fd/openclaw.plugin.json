{
  "id": "tekken-fd",
  "name": "Tekken Frame Data",
  "description": "Tekken 8 frame data lookups from Wavu Wiki (git-versioned snapshots + SQLite index) for Telegram groups.",
  "categories": [
    "productivity"
  ],
  "enabledByDefault": false,
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "tekken_frame_data",
      "tekken_pick_move"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "repoDir": {
        "type": "string"
      },
      "stateDir": {
        "type": "string"
      },
      "ownerChatId": {
        "type": "string"
      },
      "watcher": {
        "type": "boolean"
      },
      "fastPathAgents": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "publicAgents": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "adminIds": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "quiz": {
        "type": "object",
        "properties": {
          "dailyAt": {
            "type": "string"
          },
          "tz": {
            "type": "string"
          },
          "daily": {
            "type": "boolean"
          }
        }
      },
      "coach": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "access": {
            "enum": [
              "admins",
              "clan"
            ]
          },
          "model": {
            "type": "string"
          },
          "models": {
            "type": "object"
          },
          "allowlist": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "tips": {
        "type": "object",
        "properties": {
          "openSubmissions": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
